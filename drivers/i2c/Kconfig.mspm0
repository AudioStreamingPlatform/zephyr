# SPDX-License-Identifier: Apache-2.0

config I2C_MSPM0
	bool "TI I2C MSPM0 driver"
	default y
	depends on DT_HAS_TI_MSPM0_I2C_ENABLED
	help
	  Enable support for I2C on the TI MSPM0 series.

if I2C_MSPM0

config I2C_MSPM0_TARGET_SUPPORT
	bool "TI I2C_MSPM0 target support"
	default n
	help
	  Enable support for i2c-target functionality
	  for TI MSPM0 driver.

config I2C_MSPM0_TRANSFER_TIMEOUT
	int "Transfer timeout [ms]"
	default 100
	help
	  Timeout in milliseconds used for each I2C transfer.
	  0 means that the driver should use the K_FOREVER value,
	  i.e. it should wait as long as necessary.

config I2C_MSPM0_WATCHDOG
	bool "TI I2C MSPM0 watchdog support"
	help
	  Enable support for a watchdog plugin that NACKs the I2C message
	  and panics the device if the processing of a byte takes too long.

if I2C_MSPM0_WATCHDOG

config I2C_MSPM0_WATCHDOG_TIMEOUT
    int "I2C watchdog reset timeout (us)"
    default 300
    help
      Defines the timeout in microseconds after which the watchdog will
      reset the I2C lines and trigger a system panic.

config I2C_MSPM0_WATCHDOG_PANIC_CODE
    int "I2C watchdog reset panic code"
    default 17
    help
      Defines the panic code that will be triggered when the I2C watchdog
      times out and resets the I2C lines. This code can be used for debugging
      or logging the failure reason.


config I2C_MSPM0_INIT_PRIORITY
    int "TI I2C MSPM0 init priority"
    default COUNTER_INIT_PRIORITY
    help
      Define the driver init priority. The driver has a dependency on the counter
      component.

endif # I2C_MSPM0_WATCHDOG

endif # I2C_MSPM0
